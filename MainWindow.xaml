  <Style TargetType="TextBox"><Setter Property="Background" Value="#111412"/><Setter Property="Foreground" Value="#EEF1EE"/><Setter Property="BorderBrush" Value="#39413B"/><Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#191C1A"/><Setter Property="Foreground" Value="#EEF1EE"/><Setter Property="BorderBrush" Value="#39413B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton x:Name="ToggleButton" Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5"><Grid><ContentPresenter Margin="8,0,28,0" VerticalAlignment="Center"/><TextBlock Text="⌄" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0"/></Grid></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center" Margin="7,0,25,0" IsHitTestVisible="False"/><Popup x:Name="Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#191C1A" BorderBrush="#39413B" BorderThickness="1" CornerRadius="5" MinWidth="{TemplateBinding ActualWidth}"><ScrollViewer MaxHeight="300"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.55"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Background" Value="#191C1A"/><Setter Property="Foreground" Value="#EEF1EE"/><Setter Property="Padding" Value="8,7"/><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#303932"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#242925"/><Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/></Trigger></Style.Triggers></Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="#ADB4AE"/><Setter Property="Padding" Value="16,11"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="0,0,0,2"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid><Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="206"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Grid Grid.Row="0" Grid.ColumnSpan="2" Background="#171918" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0"><Border Width="26" Height="26" CornerRadius="5" Background="White"><Image Source="pack://application:,,,/Assets-icon.ico" Stretch="Uniform" Margin="2"/></Border><TextBlock Text="PistolLauncher" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" Foreground="#E4E9E5"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="MinimizeButton" Content="—" Width="46" Height="42" Padding="0" Background="Transparent" BorderBrush="Transparent" Click="MinimizeWindow_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><Button x:Name="MaximizeButton" Content="□" Width="46" Height="42" Padding="0" FontSize="19" FontWeight="Normal" Background="Transparent" BorderBrush="Transparent" Click="MaximizeWindow_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/><Button Content="×" Width="46" Height="42" Padding="0" FontSize="23" FontWeight="Normal" Background="Transparent" BorderBrush="Transparent" Click="CloseWindow_Click" shell:WindowChrome.IsHitTestVisibleInChrome="True"/></StackPanel></Grid>
  <Border Grid.Row="1" Grid.Column="0" Background="#141615" BorderBrush="#303632" BorderThickness="0,0,1,0"><DockPanel Margin="15,22"><StackPanel DockPanel.Dock="Top"><StackPanel Orientation="Horizontal" Margin="4,0,0,32"><Border Width="37" Height="37" CornerRadius="10" Background="White"><Image Source="pack://application:,,,/Assets-icon.ico" Width="29" Height="29" Stretch="Uniform"/></Border><StackPanel VerticalAlignment="Center" Margin="10,0,0,0"><TextBlock Text="PISTOL" FontWeight="Bold" FontSize="15"/><TextBlock Text="LAUNCHER" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="11"/></StackPanel></StackPanel><TextBlock Text="НАВИГАЦИЯ" Foreground="#788079" FontSize="10" Margin="8,0,0,12"/><Button x:Name="NavHome" Style="{StaticResource NavButton}" Content="⌂   Домой" HorizontalContentAlignment="Left" Click="HomeNav_Click"/><Button x:Name="NavVersions" Style="{StaticResource NavButton}" Content="◈   Версии" HorizontalContentAlignment="Left" Click="VersionsNav_Click" Margin="0,3,0,5"/><TextBlock Text="Модификации и сборки" Foreground="#788079" FontSize="10" Margin="8,20,0,8"/><Button x:Name="NavCatalog" Style="{StaticResource NavButton}" Content="⌕   Каталог" HorizontalContentAlignment="Left" Click="CatalogNav_Click"/><TextBlock Text="ПРОФИЛЬ" Foreground="#788079" FontSize="10" Margin="8,20,0,8"/><Button x:Name="NavCloset" Style="{StaticResource NavButton}" Content="👕   Шкафчик" FontFamily="Segoe UI Emoji" HorizontalContentAlignment="Left" Click="ClosetNav_Click"/><Button x:Name="NavFiles" Style="{StaticResource NavButton}" Content="▤   Minecraft" HorizontalContentAlignment="Left" Click="FilesNav_Click"/><Button x:Name="NavAccounts" Style="{StaticResource NavButton}" HorizontalContentAlignment="Left" Click="AccountsNav_Click"><StackPanel Orientation="Horizontal"><TextBlock Text="♙" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/><TextBlock x:Name="AccountsNavLabel" Text="Аккаунты"/></StackPanel></Button><Button x:Name="NavSettings" Style="{StaticResource NavButton}" Content="⚙   Настройки" HorizontalContentAlignment="Left" Click="SettingsNav_Click"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><Border Height="1" Background="#303632" Margin="0,0,0,14"/><TextBlock Text="PistolLauncher" Foreground="#788079" FontSize="11" Margin="8,0,0,5"/><TextBlock x:Name="SidebarProfile" Text="Офлайн-профиль" Foreground="#788079" FontSize="10" Margin="8,0,0,4"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="1" Grid.Column="1" Margin="28,0,28,20"><Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0"><TextBlock x:Name="TopCrumb" Text="PistolLauncher / Обзор" Foreground="#A0A8A2" VerticalAlignment="Center"/><ComboBox x:Name="ProfileSelector" Width="210" Height="34" HorizontalAlignment="Right" VerticalAlignment="Center" SelectionChanged="ProfileSelector_SelectionChanged" ToolTip="Выбранный игровой профиль"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Avatar}" Width="22" Height="22" Stretch="UniformToFill" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/><TextBlock Text="{Binding Label}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
   <TabControl x:Name="Pages" Grid.Row="1" Background="Transparent" BorderBrush="#303632" Foreground="#EEF1EE" SelectionChanged="Pages_SelectionChanged">
    <TabItem Header="Домой"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="245"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="0,6,0,18"><StackPanel><TextBlock Text="ТВОЯ ИГРА. ТВОИ ПРАВИЛА." Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontSize="11"/><TextBlock x:Name="WelcomeText" Text="С возвращением, Player" FontSize="27" FontWeight="Bold" Margin="0,5,0,0"/><TextBlock Text="Выбери инстанс или собери свой собственный." Foreground="#939B95" Margin="0,5,0,0"/></StackPanel><Button Content="＋ Новая сборка" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddInstance_Click"/></Grid><Border Grid.Row="1" Background="#1A201B" BorderBrush="#39413B" BorderThickness="1" CornerRadius="12" ClipToBounds="True"><Grid><Ellipse Width="175" Height="175" Fill="#27341F" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,70,0"/><Ellipse Width="225" Height="75" Stroke="#91C4FF55" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,45,0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><RotateTransform Angle="-24"/></Ellipse.RenderTransform></Ellipse><TextBlock Text="P / 01" Foreground="#AFC98D" FontFamily="Consolas" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,160,52,0"/><StackPanel VerticalAlignment="Center" Margin="28,0" MaxWidth="540" HorizontalAlignment="Left"><TextBlock Text="PISTOL LAUNCHER" Foreground="{DynamicResource AccentBrush}" FontFamily="Consolas" FontSize="11"/><TextBlock Text="Твой мир начинается здесь" FontSize="26" FontWeight="Bold" Margin="0,14,0,5"/><TextBlock Text="Создавай отдельные инстансы, скачивай моды и держи все сборки в одном месте." TextWrapping="Wrap" Foreground="#B2BAB3"/><Button Content="Открыть мои инстансы  →" HorizontalAlignment="Left" Margin="0,17,0,0" Background="{DynamicResource AccentBrush}" Foreground="#13170E" BorderBrush="{DynamicResource AccentBrush}" Click="VersionsNav_Click"/></StackPanel><TextBlock Text="JAVA  ·  MODRINTH  ·  CURSEFORGE" Foreground="#CDD4CA" FontFamily="Consolas" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,15"/></Grid></Border><Grid Grid.Row="2" Margin="0,20,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Твои инстансы" FontWeight="Bold" FontSize="16"/><TextBlock x:Name="HomeInstanceSummary" Text="Пока нет инстансов — создай первый." Foreground="#939B95" FontSize="11" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" Content="Все инстансы →" Click="VersionsNav_Click" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource AccentBrush}"/></Grid><Border Grid.Row="3" Background="#191C1A" BorderBrush="#303632" BorderThickness="1" CornerRadius="9" Padding="15"><ListBox x:Name="HomeInstanceList" Background="Transparent" BorderThickness="0" Foreground="#EEF1EE" MouseDoubleClick="HomeInstance_DoubleClick"><ListBox.ItemTemplate><DataTemplate><Grid Margin="2,6"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><Image Grid.Column="0" Width="38" Height="38" Source="{Binding Avatar}" Stretch="UniformToFill" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="Bold"/><TextBlock Text="{Binding Summary}" Foreground="#939B95" FontSize="11" Margin="0,3,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding LoaderLabel}" Foreground="#A5ADA7" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Border></Grid></TabItem>
    <TabItem Header="Версии"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="0,8,0,18"><StackPanel><TextBlock Text="Твои инстансы" FontSize="27" FontWeight="Bold"/><TextBlock Text="Каждая версия живёт отдельно в minecraft/instances." Foreground="#939B95" Margin="0,6,0,0"/></StackPanel><Button Content="⟳ Обновить" HorizontalAlignment="Right" VerticalAlignment="Center" Click="RefreshInstances_Click"/></Grid><Border Grid.Row="1" Background="#191C1A" BorderBrush="#303632" BorderThickness="1" CornerRadius="9" Padding="15"><ListBox x:Name="InstanceList" Background="Transparent" BorderThickness="0" Foreground="#EEF1EE" SelectionChanged="InstanceList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#303632" BorderThickness="0,0,0,1" Padding="10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="46"/><ColumnDefinition Width="*"/><ColumnDefinition Width="125"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Grid.Column="0" Width="38" Height="38" Source="{Binding Avatar}" Stretch="UniformToFill" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/><TextBlock Text="{Binding Summary}" Foreground="#939B95" FontSize="11" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding LoaderLabel}" Foreground="#A5ADA7" VerticalAlignment="Center"/><Button Grid.Column="3" Content="{DynamicResource InstanceOpenFolderText}" Padding="11,6" Margin="0,0,6,0" Tag="{Binding}" Click="OpenInstance_Click"/><Button Grid.Column="4" Content="{DynamicResource InstanceRenameText}" Padding="8,6" Margin="0,0,4,0" Tag="{Binding}" Click="RenameInstance_Click"/><Button Grid.Column="5" Content="{DynamicResource InstanceDeleteText}" Padding="11,6" Tag="{Binding}" Click="DeleteInstance_Click"/><Button Grid.Column="6" Content="{DynamicResource InstanceCloseText}" Padding="11,6" Margin="6,0,0,0" Tag="{Binding}" Click="CloseInstanceGame_Click"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border><Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="Загружаю каталог Minecraft…" Foreground="#939B95"/><ProgressBar x:Name="DownloadProgress" Height="5" Margin="0,8,24,0" Minimum="0" Maximum="100" Value="0" Background="#303632" Foreground="{DynamicResource AccentBrush}"/><TextBlock x:Name="DetailText" Text="" Foreground="#788079" FontSize="10" Margin="0,6,0,0"/></StackPanel><Button Content="▶ Играть" Grid.Column="1" Margin="0,0,8,0" Background="{DynamicResource AccentBrush}" Foreground="#13170E" BorderBrush="{DynamicResource AccentBrush}" Click="LaunchInstance_Click"/><Button Content="＋ Добавить инстанс" Grid.Column="2" Background="{DynamicResource AccentBrush}" Foreground="#13170E" BorderBrush="{DynamicResource AccentBrush}" Click="AddInstance_Click"/></Grid></Grid></TabItem>
    <TabItem Header="Каталог"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,8,0,18"><TextBlock Text="Каталог модов" FontSize="27" FontWeight="Bold"/><TextBlock Text="Моды, ресурспаки и шейдеры из Modrinth и CurseForge." Foreground="#939B95" Margin="0,6,0,0"/></StackPanel><Grid Grid.Row="1" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="120"/><ColumnDefinition Width="110"/><ColumnDefinition Width="210"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="CatalogQuery" Grid.Column="0" Margin="0,0,8,0" ToolTip="Название мода, ресурспака или шейдера"/><ComboBox x:Name="CatalogSource" Grid.Column="1" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="CatalogFilters_SelectionChanged"><ComboBoxItem Content="Все источники" Tag="all"/><ComboBoxItem Content="Modrinth" Tag="modrinth"/><ComboBoxItem Content="CurseForge" Tag="curseforge"/></ComboBox><ComboBox x:Name="ProjectKind" Grid.Column="2" Margin="0,0,8,0" SelectedIndex="0" SelectionChanged="CatalogFilters_SelectionChanged"><ComboBoxItem Content="Моды" Tag="mod"/><ComboBoxItem Content="Ресурспаки" Tag="resourcepack"/><ComboBoxItem Content="Шейдеры" Tag="shader"/></ComboBox><ComboBox x:Name="TargetInstance" Grid.Column="3" Margin="0,0,8,0" ToolTip="Инстанс или общая папка для ресурспаков и шейдеров" SelectionChanged="CatalogFilters_SelectionChanged"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="4" Content="Искать" Click="SearchCatalog_Click" Background="{DynamicResource AccentBrush}" Foreground="#13170E" BorderBrush="{DynamicResource AccentBrush}" Margin="0,0,7,0"/><Button Grid.Column="5" Content="⟳ Обновить" Click="SearchCatalog_Click"/></Grid><Border Grid.Row="2" Background="#191C1A" BorderBrush="#303632" BorderThickness="1" CornerRadius="9" Padding="10"><ListBox x:Name="CatalogResults" ScrollViewer.ScrollChanged="CatalogResults_ScrollChanged" Background="Transparent" BorderThickness="0" Foreground="#EEF1EE"><ListBox.ItemTemplate><DataTemplate><Border BorderBrush="#303632" BorderThickness="0,0,0,1" Padding="8,10"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Image Grid.Column="0" Width="36" Height="36" Source="{Binding Avatar}" Stretch="UniformToFill" VerticalAlignment="Center" Margin="0,0,8,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Foreground="#939B95" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding DownloadsLabel}" Foreground="#A5ADA7" VerticalAlignment="Center"/><Button Grid.Column="3" Content="Скачать" Padding="12,6" Tag="{Binding}" Click="DownloadProject_Click"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Border><Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><TextBlock x:Name="CatalogStatus" Text="Modrinth доступен без ключа. Для CurseForge потребуется свой API-ключ." Foreground="#939B95" VerticalAlignment="Center" TextWrapping="Wrap"/><Button Grid.Column="1" Content="Настроить CurseForge API key" Click="ConfigureCurseForge_Click"/></Grid></Grid></TabItem>
    <TabItem Header="Шкафчик"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,8,0,18"><TextBlock Text="Шкафчик" FontSize="27" FontWeight="Bold"/><TextBlock x:Name="ClosetProfileText" Text="Выбери профиль в правом верхнем углу." Foreground="#939B95" Margin="0,6,0,0"/></StackPanel><Border Grid.Row="1" Background="#191C1A" BorderBrush="#303632" BorderThickness="1" CornerRadius="9" Padding="28"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="200" Height="370" Background="#202522" CornerRadius="9" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"><Viewport3D x:Name="ClosetSkinViewport" ClipToBounds="True" MouseLeftButtonDown="SkinViewport_MouseLeftButtonDown" MouseMove="SkinViewport_MouseMove" MouseLeftButtonUp="SkinViewport_MouseLeftButtonUp" MouseWheel="SkinViewport_MouseWheel" RenderOptions.BitmapScalingMode="NearestNeighbor"><Viewport3D.Camera><PerspectiveCamera x:Name="SkinCamera" Position="2,1.4,3.2" LookDirection="-2,-0.9,-3.2" UpDirection="0,1,0" FieldOfView="26"/></Viewport3D.Camera></Viewport3D></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="24,0"><TextBlock x:Name="ClosetTitle" Text="Скин выбранного профиля" FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock x:Name="ClosetStatus" Text="Здесь будет отображаться скин активного профиля." Foreground="#939B95" TextWrapping="Wrap" Margin="0,12,0,18"/><Button x:Name="UploadOfflineSkinButton" Content="Загрузить скин" Click="ChooseSkin_Click" HorizontalAlignment="Left" Visibility="Collapsed" Background="{DynamicResource AccentBrush}" Foreground="#13170E" BorderBrush="{DynamicResource AccentBrush}"/></StackPanel></Grid></Border></Grid></TabItem>
    <TabItem Header="Minecraft"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Margin="0,8,0,18"><TextBlock Text="Файлы Minecraft" FontSize="27" FontWeight="Bold"/><TextBlock Text="Просмотр папки minecraft внутри PistolLauncher." Foreground="#939B95" Margin="0,6,0,0"/></StackPanel><DockPanel Grid.Row="1" Margin="0,0,0,12"><Button Content="← Назад" Click="FilesBack_Click" DockPanel.Dock="Left" Margin="0,0,7,0"/><Button Content="↑ Вверх" Click="FilesUp_Click" DockPanel.Dock="Left" Margin="0,0,9,0"/><Button Content="Удалить" Click="DeleteFile_Click" DockPanel.Dock="Right" Margin="7,0,0,0" ToolTip="Зажми Shift, чтобы удалить без подтверждения"/><TextBox x:Name="FilePath" IsReadOnly="True"/></DockPanel><Border Grid.Row="2" Background="#191C1A" BorderBrush="#303632" BorderThickness="1" CornerRadius="9" Padding="10"><ListBox x:Name="FileList" PreviewKeyDown="FileList_PreviewKeyDown" Background="Transparent" BorderThickness="0" Foreground="#EEF1EE" MouseDoubleClick="FileList_DoubleClick"/></Border></Grid></TabItem>
    <TabItem Header="Аккаунты"><Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel Margin="0,8,0,18"><TextBlock Text="Профили" FontSize="27" FontWeight="Bold"/><TextBlock x:Name="AccountsDescription" Text="Выбирай аккаунт в правом верхнем углу лаунчера." Foreground="#939B95" Margin="0,6,0,0"/></StackPanel><Border Grid.Row="1" Background="#191C1A" BorderBrush="#303632" BorderThickness="1" CornerRadius="9" Padding="12"><ListBox x:Name="ProfileList" Background="Transparent" BorderThickness="0" Foreground="#EEF1EE" SelectionChanged="ProfileList_SelectionChanged"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="7,5"><Image Source="{Binding Avatar}" Width="40" Height="40" Stretch="UniformToFill" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding TypeLabel}" FontSize="11" Foreground="#939B95"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Border><DockPanel Grid.Row="2" Margin="0,14,0,0"><TextBlock x:Name="AccountStatus" Text="Нет выбранного профиля" Foreground="#939B95" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="RenameProfileButton" Content="Переименовать" Click="RenameProfile_Click" Margin="0,0,7,0"/><Button Content="Удалить" Click="DeleteProfile_Click" Margin="0,0,7,0"/><Button Content="Добавить профиль" Click="AddProfile_Click" Background="{DynamicResource AccentBrush}" Foreground="#13170E" BorderBrush="{DynamicResource AccentBrush}"/></StackPanel></DockPanel></Grid></TabItem>
    <TabItem Header="Настройки"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24" MaxWidth="780" HorizontalAlignment="Left"><TextBlock x:Name="SettingsHeading" Text="Настройки" FontSize="27" FontWeight="Bold"/><TextBlock x:Name="SettingsDescription" Text="Язык интерфейса, цвет акцента и расположение файлов Minecraft." Foreground="#939B95" Margin="0,6,0,20"/><TextBlock x:Name="SettingsLanguageLabel" Text="Язык" FontWeight="SemiBold"/><ComboBox x:Name="SettingsLanguage" Margin="0,6,0,16" SelectedIndex="0"><ComboBoxItem Content="Русский"/><ComboBoxItem Content="English"/></ComboBox><TextBlock x:Name="SettingsAccentLabel" Text="Цвет темы" FontWeight="SemiBold"/><ComboBox x:Name="SettingsAccent" Margin="0,6,0,16" SelectedIndex="0"><ComboBoxItem Content="Лаймовый" Tag="#C4FF55"/><ComboBoxItem Content="Голубой" Tag="#55D7FF"/><ComboBoxItem Content="Фиолетовый" Tag="#C278FF"/><ComboBoxItem Content="Оранжевый" Tag="#FF9B55"/></ComboBox><TextBlock x:Name="SettingsRamLabel" Text="Оперативная память Minecraft" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,16"><TextBlock x:Name="SettingsRamValue" DockPanel.Dock="Right" Width="56" TextAlignment="Right" VerticalAlignment="Center"/><Slider x:Name="SettingsRam" Minimum="1" Maximum="32" TickFrequency="1" IsSnapToTickEnabled="True" Value="4" ValueChanged="SettingsRam_ValueChanged"/></DockPanel><TextBlock x:Name="SettingsPathLabel" Text="Папка данных Minecraft" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,4"><Button x:Name="BrowseMinecraftRootButton" Content="Выбрать…" DockPanel.Dock="Right" Click="BrowseMinecraftRoot_Click"/><TextBox x:Name="SettingsMinecraftRoot" Margin="0,0,8,0"/></DockPanel><TextBlock x:Name="SettingsPathNote" Text="Новая папка используется для загрузок и инстансов. Существующие файлы автоматически не перемещаются." Foreground="#939B95" TextWrapping="Wrap" Margin="0,0,0,16"/><TextBlock x:Name="SettingsJavaPathLabel" Text="Папка Java (JAVA_HOME)" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,16"><Button x:Name="BrowseJavaPathButton" Content="Выбрать…" DockPanel.Dock="Right" Click="BrowseJavaPath_Click"/><TextBox x:Name="SettingsJavaPath" Margin="0,0,8,0"/></DockPanel><TextBlock x:Name="SettingsAppPathLabel" Text="Папка лаунчера" FontWeight="SemiBold"/><DockPanel Margin="0,6,0,18"><Button Content="Открыть" DockPanel.Dock="Right" Click="OpenLauncherFolder_Click"/><TextBox x:Name="SettingsLauncherRoot" IsReadOnly="True" Margin="0,0,8,0"/></DockPanel><WrapPanel><Button x:Name="SaveSettingsButton" Content="Сохранить настройки" Click="SaveSettings_Click" Background="{DynamicResource AccentBrush}" Foreground="#13170E" BorderBrush="{DynamicResource AccentBrush}"/><Button x:Name="OpenMinecraftRootButton" Content="Открыть папку Minecraft" Click="OpenMinecraftRoot_Click" Margin="8,0,0,0"/></WrapPanel><TextBlock x:Name="SettingsStatus" Foreground="#939B95" TextWrapping="Wrap" Margin="0,14,0,0"/></StackPanel></ScrollViewer></TabItem>   </TabControl>
  </Grid>
  <Button Grid.Row="1" Grid.Column="1" x:Name="HelpAssistant" Width="66" Height="66" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,34,28" Padding="4" Background="White" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" ToolTip="Pistol FAQ — помощник" Click="Assistant_Click" Panel.ZIndex="50"><Image x:Name="AssistantImage" Stretch="UniformToFill"/></Button>
 </Grid>
</Window>














