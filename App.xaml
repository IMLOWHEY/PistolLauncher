<Application x:Class="PistolLauncher.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#101111"/><SolidColorBrush x:Key="Panel" Color="#191C1A"/><SolidColorBrush x:Key="Line" Color="#303632"/><SolidColorBrush x:Key="Lime" Color="#C4FF55"/><SolidColorBrush x:Key="Muted" Color="#939B95"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#EEF1EE"/><Setter Property="Background" Value="#242925"/><Setter Property="BorderBrush" Value="#39413B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  </Application.Resources>
</Application>
